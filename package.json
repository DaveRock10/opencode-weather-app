{
  "name": "02-weather",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun run src/index.ts --watch",
    "typecheck": "bun check",
    "test": "bun test --isolate tests",
    "test:watch": "bun test --isolate --watch tests",
    "test:coverage": "bun test --isolate --coverage tests",
    "verify": "bun check && bun test --isolate tests",
    "build": "bun test --isolate tests && bun build --compile src/index.ts --outfile weather"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^7"
  }
}
